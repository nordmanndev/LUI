<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared test infrastructure: the database a test works on, the corpus
    it reads, the fixtures the tests share. It is a library, not a test
    project — it holds no tests of its own, and it is not packed.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nordmann.LUI.Testing</RootNamespace>
    <AssemblyName>Nordmann.LUI.Testing</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The budgets of the repository (ADR-0056): one file, two readers. It travels
      with the assembly, so the reader of the file and the reader of the promise
      read the same one.
    -->
    <EmbeddedResource Include="Budgets/budgets.json" LogicalName="Nordmann.LUI.Testing.Budgets.budgets.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Nordmann.LUI/Nordmann.LUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>

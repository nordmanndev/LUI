<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The integration tests: the library against a real SQLite database — the
    schema, the writes, the query path, the ranking, the sync. Every test here
    owns a database file of its own and deletes it afterwards.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- an xUnit.net v3 test project is an executable; dotnet test runs it through VSTest, not through
         Microsoft.Testing.Platform, which on the .NET 10 SDK refuses the VSTest target (ADR-0051) -->
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <RootNamespace>Nordmann.LUI.Integration.Tests</RootNamespace>
    <AssemblyName>Nordmann.LUI.Integration.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!--
      A real host for the tests of Nordmann.LUI.Hosting (the dependency injection, the warm-up). The abstractions of the
      host come with it; they are named because Directory.Packages.props holds their versions, and an architecture test
      wants every central version referenced by a project (ADR-0018).
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Nordmann.LUI/Nordmann.LUI.csproj" />
    <ProjectReference Include="../Nordmann.LUI.Testing/Nordmann.LUI.Testing.csproj" />
    <ProjectReference Include="../../src/Nordmann.LUI.Hosting/Nordmann.LUI.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>

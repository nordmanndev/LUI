<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The unit tests: the rules of the library on their own, without a database.
    They read the source of the library and the tables of the specification —
    a change to the normalisation rule or to the ranking is visible here in
    seconds, without a file, a connection or a schema.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- an xUnit.net v3 test project is an executable; dotnet test runs it through VSTest, not through
         Microsoft.Testing.Platform, which on the .NET 10 SDK refuses the VSTest target (ADR-0051) -->
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <RootNamespace>Nordmann.LUI.Unit.Tests</RootNamespace>
    <AssemblyName>Nordmann.LUI.Unit.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <!-- the library that LUI's own similarity measures replace: the tests compare against it (issue #30) -->
    <PackageReference Include="F23.StringSimilarity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Nordmann.LUI/Nordmann.LUI.csproj" />
    <!--
      The shared infrastructure, for the rules of the budget (ADR-0058): the logic of a
      target belongs to the rules, and a rule is tested here. The layer opens no
      database — the guard of TestLandscapeTests reads this source and says so.
    -->
    <ProjectReference Include="../Nordmann.LUI.Testing/Nordmann.LUI.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>

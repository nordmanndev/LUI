<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The unit tests: the rules of the library on their own, without a database.
    They read the source of the library and the tables of the specification —
    a change to the normalisation rule or to the ranking is visible here in
    seconds, without a file, a connection or a schema.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nordmann.LUI.Unit.Tests</RootNamespace>
    <AssemblyName>Nordmann.LUI.Unit.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <!-- the library that LUI's own similarity measures replace: the tests compare against it (issue #30) -->
    <PackageReference Include="F23.StringSimilarity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Nordmann.LUI/Nordmann.LUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The sample (PR-011, ADR-0027): an ASP.NET Core app that serves a static client and a small API in front of the
    public surface of Nordmann.LUI and Nordmann.LUI.Hosting — the way an application would use the packages.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nordmann.LUI.Sample</RootNamespace>
    <AssemblyName>Lui.Sample</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests of the sample reach into it: they hold what its routes answer (ADR-0027, ADR-0029). -->
    <InternalsVisibleTo Include="Lui.Sample.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Nordmann.LUI/Nordmann.LUI.csproj" />
    <ProjectReference Include="../../src/Nordmann.LUI.Hosting/Nordmann.LUI.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <!-- Bogus, the fake data the bulk indexes are filled with (ADR-0029). The sample is not shipped; the two packages keep
         their dependency set. -->
    <PackageReference Include="Bogus" />
  </ItemGroup>

</Project>

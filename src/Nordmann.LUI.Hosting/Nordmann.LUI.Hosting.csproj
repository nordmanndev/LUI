<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nordmann.LUI</RootNamespace>
    <AssemblyName>Nordmann.LUI.Hosting</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The second package (ADR-0018): LUI in a .NET host — AddLui, and nothing else. The container holds the catalog and
    no index (ADR-0033); the application asks the catalog for what it needs. The package knows only the public API of
    Nordmann.LUI and is released with it, with the same version (VersionPrefix in Directory.Build.props).
  -->
  <PropertyGroup>
    <PackageId>Nordmann.LUI.Hosting</PackageId>
    <Title>LUI — the catalog in the container</Title>
    <Description>Nordmann.LUI in an ASP.NET Core or worker application: AddLui puts the catalog into the container. The application creates its indexes with the catalog (catalog.Create) and opens them in the runtime path (catalog.Index).</Description>
    <PackageTags>autocomplete;typeahead;suggestions;sqlite;fts5;dependency-injection;hosting</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/nuget</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nordmann.LUI.Unit.Tests" />
    <InternalsVisibleTo Include="Nordmann.LUI.Integration.Tests" />
    <InternalsVisibleTo Include="Nordmann.LUI.Architecture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Nordmann.LUI/Nordmann.LUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!--
    The core is pinned exactly: Nordmann.LUI.Hosting x.y.z depends on Nordmann.LUI [x.y.z], not >= x.y.z (owner's
    decision, #24, ADR-0018). The two packages are released together with one version; in 0.x a newer core may change a
    signature the hosting calls, and the mismatch would surface at run time (MissingMethodException), not at compile
    time. NuGet makes a project reference a lower bound; this rewrites the version of the core's reference to an exact
    range after NuGet read it, before the nuspec is written.
  -->
  <Target Name="PinTheCoreExactly" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
                                       Condition="'%(Filename)' == 'Nordmann.LUI'"
                                       ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>

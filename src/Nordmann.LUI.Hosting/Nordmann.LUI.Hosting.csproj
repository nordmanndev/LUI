<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nordmann.LUI</RootNamespace>
    <AssemblyName>Nordmann.LUI.Hosting</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The second package (ADR-0018): LUI in a .NET host — AddLui, keyed services, the hosted services. It knows only the
    public API of Nordmann.LUI and is released with it, with the same version (VersionPrefix in Directory.Build.props).
  -->
  <PropertyGroup>
    <PackageId>Nordmann.LUI.Hosting</PackageId>
    <Title>LUI — dependency injection and hosted services</Title>
    <Description>Nordmann.LUI in an ASP.NET Core or worker application: AddLui, every index as a keyed service, the indexes ensured on start, the outbox of a linked index applied on a timer.</Description>
    <PackageTags>autocomplete;typeahead;suggestions;sqlite;fts5;dependency-injection;hosting</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/nuget</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nordmann.LUI.Unit.Tests" />
    <InternalsVisibleTo Include="Nordmann.LUI.Integration.Tests" />
    <InternalsVisibleTo Include="Nordmann.LUI.Architecture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Nordmann.LUI/Nordmann.LUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nordmann.LUI</RootNamespace>
    <AssemblyName>Nordmann.LUI</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package metadata (ADR-0001: exactly one package) -->
  <PropertyGroup>
    <PackageId>Nordmann.LUI</PackageId>
    <Title>LUI — autocomplete suggestions on SQLite</Title>
    <Description>Autocomplete suggestions for .NET, straight out of your own SQLite database. FTS5 trigram search, priority-first candidates, word-start ranking, typo tolerance. A library — no server, no ORM, no runtime of its own.</Description>
    <PackageTags>autocomplete;typeahead;suggestions;sqlite;fts5;search;dropdown</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/nuget</PackageOutputPath>
  </PropertyGroup>

  <!-- Test projects may see internals; nothing else may. The unit tests read
       the rules of the library (the normaliser, the word start, the ranking)
       directly, and the integration tests read the schema and the query path. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Nordmann.LUI.Unit.Tests" />
    <InternalsVisibleTo Include="Nordmann.LUI.Integration.Tests" />
    <InternalsVisibleTo Include="Nordmann.LUI.Architecture.Tests" />
    <InternalsVisibleTo Include="Nordmann.LUI.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="symspell" />
    <PackageReference Include="F23.StringSimilarity" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!--
    The tokenizer fold table: measured from FTS5's trigram tokenizer by
    tools/FoldTableGenerator and verified against the live tokenizer by the
    parity test. The name is fixed so that the lookup does not depend on the
    project's root namespace.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Normalization/tokenizer-fold.txt" LogicalName="Nordmann.LUI.tokenizer-fold.txt" />
  </ItemGroup>

</Project>

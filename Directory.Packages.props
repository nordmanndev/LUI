<Project>

  <!--
    Central package management — mandatory (standards: architecture/layering.md
    §"Directory.Packages.props"). Versions are pinned in exactly one place;
    no .csproj may carry a Version on a PackageReference (NetArchTest rule).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    The runtime of the two packages (ADR-0018): Microsoft.Data.Sqlite and symspell are the core's (Nordmann.LUI); the
    three Microsoft.Extensions abstractions are the hosting package's (Nordmann.LUI.Hosting) only.
  -->
  <ItemGroup Label="Runtime — shipped inside Nordmann.LUI and Nordmann.LUI.Hosting">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="symspell" Version="6.7.3" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <!--
    The library whose similarity measures LUI implements itself (ADR-0030): a test dependency, never shipped. The
    parity tests compare LUI's measures against it — that comparison is the proof.
  -->
  <ItemGroup Label="Test — the library that LUI's own measures replace">
    <PackageVersion Include="F23.StringSimilarity" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.320" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <!-- a real host for the tests of Nordmann.LUI.Hosting and the package smoke test; not shipped (ADR-0018) -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Benchmark">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
